{
  "multipart": [
    {
      "apply": {
        "model": "millenaire:block/painted_brick_silver"
      }
    },
    {
      "when": {
        "top_frieze": "true"
      },
      "apply": {
        "model": "millenaire:block/painted_brick_decoration_silver_top"
      }
    },
    {
      "when": {
        "bottom_frieze": "true",
        "top_frieze": "false"
      },
      "apply": {
        "model": "millenaire:block/painted_brick_decoration_silver_bottom"
      }
    },
    {
      "when": {
        "bottom_frieze": "false",
        "top_frieze": "false"
      },
      "apply": {
        "model": "millenaire:block/painted_brick_decoration_silver"
      }
    }
  ]
}
